' Konditoro Konzept
'________________________

@startuml Konzeptmodell_Konditorio

skinparam classAttributeIconSize 0
skinparam linetype ortho
hide methods

class Konditorio

class Standort

class Filiale {
  adresse
  etagennummer
}

class Kueche
class Buero
class Verkaufsraum
class Kuehlraum

abstract class Personal {
  personalnummer
}

class Chef {
  personalnummer
}

class Konditor {
  personalnummer
}

class Servicekraft {
  personalnummer
}

class Konditioreiprodukt

' ── Vererbung ─────────────────────────────────────────────────
Personal <|-- Chef
Personal <|-- Konditor
Personal <|-- Servicekraft

' ── Beziehungen ───────────────────────────────────────────────
Konditorio  "1"    *--- "1..*"  Standort          : hat
Standort    "1"    *--- "1..*"  Filiale           : besteht aus
Standort    "1"    o--- "1"     Chef              : hat
Standort    "1"    o--- "1"     Konditor          : hat
Standort    "1"    o--- "3..5"  Servicekraft      : hat

Filiale     "1"    *--- "1"     Kueche            : enthält
Filiale     "1"    *--- "1"     Buero             : enthält
Filiale     "1"    *--- "1"     Verkaufsraum      : enthält
Filiale     "1"    *--- "1"     Kuehlraum         : enthält

Konditor    "1"    --- "1..*"   Konditioreiprodukt : stellt her
Konditorio  "1"    --- "1..*"   Konditioreiprodukt : verkauft

@enduml
