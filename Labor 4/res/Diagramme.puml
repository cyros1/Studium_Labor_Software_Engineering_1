'Theaterbesuch
'________________________
@startuml Theaterbesuch

left to right direction
skinparam packageStyle rectangle
skinparam linetype ortho

actor "Studentin" as S
actor "Freunde" as F
actor "Kassierer" as K

rectangle "Theaterbesuchs System" {

  ' (a) Grundlegende Use-Cases
  usecase "Theater besuchen"         as UC_theater
  usecase "Ticket kaufen"            as UC_ticket
  usecase "Vorstellung ansehen"      as UC_show

  ' (b) include-Beziehungen
  usecase "Vorbereitungen durchführen" as UC_prep
  usecase "Wohnung verlassen"          as UC_leave
  usecase "Handy einstecken"           as UC_phone
  usecase "Computer herunterfahren"    as UC_pc

  ' (c) Generalisierung
  usecase "Alleine besuchen"         as UC_alone
  usecase "In Gruppe besuchen"       as UC_group
  usecase "Theaterprogramm lesen"    as UC_program

  ' (d) extend-Beziehungen
  usecase "Mit E-Bike fahren"        as UC_bike
  usecase "Batterien prüfen"         as UC_battery
}

' ── Assoziationen ──────────────────────────────────────────────
S "1" -- "1"    UC_theater
S "1" -- "1"    UC_ticket
S "1" -- "1"    UC_show
S "1" -- "0..*" UC_prep
S "1" -- "0..1" UC_bike

F "0..*" -- "1" UC_theater

K "1"    -- "1" UC_ticket

' ── include-Beziehungen ────────────────────────────────────────
UC_theater  ..> UC_prep   : <<include>>
UC_prep     ..> UC_leave  : <<include>>
UC_leave    ..> UC_phone  : <<include>>
UC_leave    ..> UC_pc     : <<include>>

' ── Generalisierung ───────────────────────────────────────────
UC_alone  --|> UC_theater
UC_group  --|> UC_theater
UC_alone  .> UC_program : <<include>>
UC_group  .> UC_program : <<include>>

' ── extend-Beziehungen ────────────────────────────────────────
UC_bike   .> UC_leave   : <<extend>>
UC_bike   .> UC_battery : <<include>>

@enduml

