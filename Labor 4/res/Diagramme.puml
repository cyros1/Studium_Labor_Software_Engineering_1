'Stille Post
'________________________
@startuml Stille_Post

skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderThickness 1


participant "Anna"  as A
participant "Ben"   as B
participant "Clara" as C
participant "David" as D
participant "Eva"   as E

A -> B : flüstert(„Schmetterling")
activate B

B -> C : flüstert(„Schmetterling")
activate C

C -> D : flüstert(„Schmetteling")\n<i>minimaler Fehler</i>
activate D

D -> E : flüstert(„Schmetterding")
activate E

E -> E : sagt laut: „Schmetterding"
deactivate E
deactivate D
deactivate C
deactivate B

note over A, E
  Vergleich:
  Original „Schmetterling" ≠ Ergebnis „Schmetterding"
end note

@enduml
